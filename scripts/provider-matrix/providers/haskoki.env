# shellcheck shell=bash disable=SC2034  # sourced interface: the cell reads these names
# Haskoki 0.5.0.0 — the owner's PKCS#11 software token (Haskell + OpenSSL).
# Module candidates are probed in order: the pinned release-tarball unpack
# (scripts/ci/fetch-provider.sh haskoki) wins; nothing else provides it.
# Token setup follows the archive's INSTALL.md: a fresh backend.toml +
# sqlite store under $TASK_DIR/haskoki/ per cell.
PROVIDER_NAME=haskoki
PROVIDER_VERSION=0.5.0.0
PROVIDER_CANDIDATES='$TASK_DIR/haskoki-0.5.0.0/lib/libhaskoki.so'
PROVIDER_SETUP=haskoki_setup
PROVIDER_ENV_VARS='HASKOKI_CONFIG=$TASK_DIR/haskoki/store/backend.toml'
PROVIDER_TEARDOWN=
PROVIDER_SUITE=yes

haskoki_setup() {
  [ -f "$PKCS11_MODULE" ] || { echo "missing unpacked bundle: $PKCS11_MODULE" >&2; return 1; }
  dir=$1/haskoki
  mkdir -p "$dir/store"
  rm -f "$dir"/store/token.sqlite*
  python3 - "$dir/store/backend.toml" "$dir/store/token.sqlite" <<'PY'
import json, pathlib, sys
pathlib.Path(sys.argv[1]).write_text('''schema_version = 1
profile = "real-crypto"
[storage]
kind = "sqlite"
path = ''' + json.dumps(sys.argv[2]) + '''
[engine]
kind = "openssl"
allow_synthetic_fallback = false
private_library_context = true
[trace]
enabled = false
''')
PY
}
