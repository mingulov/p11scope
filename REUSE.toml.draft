# SPDX-License-Identifier: GPL-3.0-or-later
# DRAFT for the end-of-integration per-file pass (lane v070-copyright).
# Covers first-party files that cannot carry a comment header (strict JSON
# and byte-exact golden/log fixtures). Rename to REUSE.toml and re-verify
# with `reuse lint` once scripts/add-copyright-headers.py has been applied
# to this checkout. No tracked binary files exist today; if one lands it
# needs an entry here.
#
# Deliberately NOT covered here (open items for the final pass):
# - Files that CAN carry comments but have no SPDX header yet: Cargo
#   manifests, .github/workflows/*.yml, deploy/k8s/*.yaml, Dockerfiles,
#   tests/fixtures p11kit .conf, *.in templates, scripts/fixtures/*.jq and
#   the extensionless fixture shims. These want real headers, not REUSE
#   entries; the headerless .c fixtures are contract-exempt
#   (LICENSE_C_FIXTURES) and need a per-file license decision first.
# - LICENSE and LICENSES/*.txt: upstream FSF texts with their own notices.
# - third-party/**: vendored sources, pinned notice originals and patches.
# - Upstream fixture data: tests/fixtures/lane13-evidence/releases/*.yaml
#   (Knative releases, keep upstream notices) and
#   tests/fixtures/vng-kernel-sha256sums/*.sums (upstream kernel hashes).
version = 1
SPDX-PackageName = "p11scope"
SPDX-PackageSupplier = "Denis Mingulov <denis@mingulov.com>"
SPDX-PackageDownloadLocation = "https://github.com/mingulov/p11scope"

[[annotations]]
path = [
    "docs/schema/*.schema.json",
    "scripts/ci-test-weights.json",
    "tests/bpf-verifier-budgets.json",
    "tests/counter-bpf-verifier-budgets.json",
    "tests/ignored-tests.json",
    "tests/privileged-campaign.json",
]
precedence = "aggregate"
SPDX-FileCopyrightText = "2026 Denis Mingulov <denis@mingulov.com>"
SPDX-License-Identifier = "GPL-3.0-or-later"

[[annotations]]
path = [
    "tests/fixtures/**/*.json",
    "tests/python/fixtures/**/*.json",
]
precedence = "aggregate"
SPDX-FileCopyrightText = "2026 Denis Mingulov <denis@mingulov.com>"
SPDX-License-Identifier = "GPL-3.0-or-later"

[[annotations]]
path = [
    "scripts/matrix/fork-expected.txt",
    "spike/expected.txt",
    "tests/fixtures/receipt/input-ledger-golden.tsv",
    "tests/python/fixtures/container-cells/d1-facts-same-inode.txt",
    "tests/python/fixtures/container-cells/d1-facts-sha-drift.txt",
    "tests/python/fixtures/container-cells/d1-facts.txt",
    "tests/python/fixtures/container-cells/d1-note.txt",
]
precedence = "aggregate"
SPDX-FileCopyrightText = "2026 Denis Mingulov <denis@mingulov.com>"
SPDX-License-Identifier = "GPL-3.0-or-later"

[[annotations]]
path = ["tests/fixtures/**/*.log"]
precedence = "aggregate"
SPDX-FileCopyrightText = "2026 Denis Mingulov <denis@mingulov.com>"
SPDX-License-Identifier = "GPL-3.0-or-later"
