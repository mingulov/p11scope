set -eu
[ "$1" = -n ] || exit 91
shift
printf '%s\n' "$*" >> "$CASE_DIR/sudo.calls"
if [ "$1" = python3 ] && [ "${3##*/}" = recorded-process-exec.py ] && [ "${4-}" = exec ]; then
    : > "$CASE_DIR/sudo.entered"
fi
exec "$@"
