# shellcheck shell=bash disable=SC2034  # sourced interface: the cell reads these names
# The p11-kit proxy: p11-kit-client.so forwards over a private socket to a
# p11-kit server started per cell, serving a task-folder SoftHSM token.
# The suite runs against the client module, so every call crosses the
# forwarding boundary. Server and client paths are probed, never assumed.
PROVIDER_NAME=p11kit-proxy
PROVIDER_VERSION=system
PROVIDER_CANDIDATES='/usr/lib64/p11-kit-proxy.so /usr/lib64/pkcs11/p11-kit-client.so /usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so'
PROVIDER_SETUP=p11kit_proxy_setup
PROVIDER_ENV_VARS='SOFTHSM2_CONF=$TASK_DIR/p11kit/softhsm2.conf'
PROVIDER_TEARDOWN=p11kit_proxy_teardown
PROVIDER_SUITE=yes

# shellcheck disable=SC1090,SC1091  # shipped sibling, delivered with the env files
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_token_dir.sh"

p11kit_proxy_setup() {
  dir=$1/p11kit
  mkdir -p "$dir"
  # A server left by an earlier cell in this task dir is stopped first;
  # teardown only targets the recorded pid after a cmdline check.
  p11kit_proxy_teardown "$1" >/dev/null 2>&1 || {
    echo "stale p11-kit server would not die; refusing a second server" >&2
    return 1
  }
  command -v p11-kit >/dev/null 2>&1 || { echo "p11-kit server binary missing" >&2; return 1; }
  softhsm=
  for cand in /usr/lib64/pkcs11/libsofthsm2.so /usr/lib/x86_64-linux-gnu/softhsm/libsofthsm2.so; do
    if [ -f "$cand" ]; then softhsm=$cand; break; fi
  done
  [ -n "$softhsm" ] || { echo "no SoftHSM library to serve" >&2; return 1; }
  printf 'directories.tokendir = %s\nobjectstore.backend = file\n' "$dir/tokens" >"$dir/softhsm2.conf"
  reset_task_token_dir "$dir/tokens" || return 1
  SOFTHSM2_CONF=$dir/softhsm2.conf softhsm2-util --init-token --slot 0 \
    --label "p11matrix" --pin "$P11TEST_PIN" --so-pin "$P11TEST_SO_PIN" || return 1
  # The server address is dynamic (a pid-keyed socket under the runtime
  # dir), so setup publishes it through the cell's extra-env hook.
  rm -f "$dir/server.sh"
  SOFTHSM2_CONF=$dir/softhsm2.conf p11-kit server --provider "$softhsm" \
    --sh "pkcs11:token=p11matrix" >"$dir/server.sh" 2>>"$dir/server.log" 7>&- 8>&- || {
    echo "p11-kit server failed to start; see $dir/server.log" >&2
    return 1
  }
  # shellcheck disable=SC1090,SC1091
  . "$dir/server.sh"
  : "${P11_KIT_SERVER_ADDRESS:?server printed no address}"
  : "${P11_KIT_SERVER_PID:?server printed no pid}"
  p11kit_server_pid_alive "$P11_KIT_SERVER_PID" || {
    echo "p11-kit pid $P11_KIT_SERVER_PID is not the server we started" >&2
    kill "$P11_KIT_SERVER_PID" 2>/dev/null || true
    return 1
  }
  echo "$P11_KIT_SERVER_PID" >"$dir/server.pid"
  printf 'P11_KIT_SERVER_ADDRESS=%s\n' "$P11_KIT_SERVER_ADDRESS" >"$1/.provider-extra-env"
  echo "p11-kit server up (pid $P11_KIT_SERVER_PID), serving $softhsm"
}

p11kit_server_pid_alive() {
  # True when $1 is still the server this cell started. The real argv is
  # `server --provider PATH --sh SELECTOR` (some p11-kit versions keep
  # `p11-kit server ...`), so matching the literal "p11-kit server"
  # never found it. The exact pid plus this argv shape guards pid reuse.
  # P11KIT_SERVER_PROC_ROOT is a self-test seam (default /proc).
  local proc_root=${P11KIT_SERVER_PROC_ROOT:-/proc} pid=${1:-} offset
  local -a args
  case $pid in ''|*[!0-9]*) return 1 ;; esac
  [ -r "$proc_root/$pid/cmdline" ] || return 1
  mapfile -d '' -t args <"$proc_root/$pid/cmdline" 2>/dev/null || return 1
  case ${args[0]:-} in
    server) offset=1 ;;
    p11-kit|*/p11-kit)
      [ "${args[1]:-}" = "server" ] || return 1
      offset=2 ;;
    *) return 1 ;;
  esac
  [ "${args[$offset]:-}" = "--provider" ] || return 1
  [ -n "${args[$((offset + 1))]:-}" ] || return 1
  [ "${args[$((offset + 2))]:-}" = "--sh" ] || return 1
  [ -n "${args[$((offset + 3))]:-}" ] || return 1
  return 0
}

p11kit_proxy_teardown() {
  dir=$1/p11kit
  [ -f "$dir/server.pid" ] || return 0
  srv=$(cat "$dir/server.pid")
  case $srv in ''|*[!0-9]*) rm -f "$dir/server.pid"; return 0 ;; esac
  # A reused pid or another process is not ours: drop the stale pidfile
  # and never signal it.
  if ! p11kit_server_pid_alive "$srv"; then
    rm -f "$dir/server.pid"
    return 0
  fi
  kill "$srv" 2>/dev/null || true
  for _ in $(seq 1 30); do
    if ! p11kit_server_pid_alive "$srv"; then
      rm -f "$dir/server.pid"
      return 0
    fi
    sleep 1
  done
  if p11kit_server_pid_alive "$srv"; then
    kill -9 "$srv" 2>/dev/null || true
    for _ in $(seq 1 10); do
      p11kit_server_pid_alive "$srv" || break
      sleep 1
    done
  fi
  if p11kit_server_pid_alive "$srv"; then
    echo "p11-kit server $srv survived SIGKILL" >&2
    return 1
  fi
  rm -f "$dir/server.pid"
  return 0
}
