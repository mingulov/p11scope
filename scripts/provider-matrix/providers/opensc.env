# shellcheck shell=bash disable=SC2034  # sourced interface: the cell reads these names
# OpenSC in reader-less mode: no token, so no suite legs. The cell proves
# C_Initialize works with zero slots (workload-pace --iterations 0 as the
# preflight probe) and then observes the init + GetSlotList calls through
# the pkcs11-tool leg and the paced inventory workload. Module candidates
# are probed in order (Fedora/Debian layouts).
PROVIDER_NAME=opensc
PROVIDER_VERSION=system
PROVIDER_CANDIDATES='/usr/lib64/pkcs11/opensc-pkcs11.so /usr/lib/x86_64-linux-gnu/pkcs11/opensc-pkcs11.so'
PROVIDER_SETUP=opensc_setup
PROVIDER_ENV_VARS=
PROVIDER_TEARDOWN=
PROVIDER_SUITE=no
# Optional preflight: run-matrix.sh runs it before the cell and records
# the provider UNRUN (not failed) when it refuses.
PROVIDER_PREFLIGHT=opensc_probe

opensc_probe() {
  mkdir -p "$1/opensc"
  # Reader-less proof: initialise and finalise with no iterations. A
  # nonzero exit means no reader-less mode (or no usable OpenSC).
  python3 -I "$PROVIDER_MATRIX_DIR/workload-pace.py" --module "$PKCS11_MODULE" \
    --ready "$1/opensc/probe.ready" --iterations 0
}

opensc_setup() {
  [ -f "$PKCS11_MODULE" ] || { echo "missing opensc module: $PKCS11_MODULE" >&2; return 1; }
  opensc_probe "$1"
}
