# shellcheck shell=bash disable=SC2034  # sourced interface: the static-embed cell reads these names
# Kryoptic 1.5.2 statically embedded in a program (no dlopenable
# module): the binary exports C_GetFunctionList/C_GetInterface/
# C_GetInterfaceList and self-drives the embedded token through that
# table. Built by scripts/provider-matrix/static-embed/build.sh and
# delivered as kryoptic-static-embed/ (binary plus BUILD.json) via
# run-matrix.sh --extra-deliver; the custom static-embed cell (not the
# standard provider-matrix cell) drives it: direct self-test, one
# `p11scope run` leg with default discovery, and discover. Run and
# discover cannot observe a static binary while the static file-scan is
# unlanded, so those rows fail with the static-executable-unobserved
# gap. Test-host only.
PROVIDER_NAME=kryoptic-static-embed
PROVIDER_VERSION=1.5.2
PROVIDER_CANDIDATES='$TASK_DIR/kryoptic-static-embed/kryoptic-static-embed'
PROVIDER_SETUP=kryoptic_static_embed_setup
PROVIDER_ENV_VARS='KRYOPTIC_CONF=$TASK_DIR/kryoptic-static-embed-run/token.conf'
PROVIDER_TEARDOWN=
PROVIDER_SUITE=no

kryoptic_static_embed_setup() {
  dir=$1/kryoptic-static-embed-run
  mkdir -p "$dir"
  printf '[[slots]]\nslot = 1\ndbtype = "sqlite"\ndbargs = "%s/token.sql"\n' "$dir" >"$dir/token.conf"
  rm -f "$dir/token.sql"
}
