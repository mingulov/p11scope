# shellcheck shell=bash disable=SC2034  # sourced interface: the cell reads these names
# FreeHSM (PKCS#11 3.2, C_GetInterface), delivered as
# $TASK_DIR/freehsm/libfreehsm.so (built from upstream main per the
# matrix README). Dev-mode bypasses (no fips.so outside FIPS hosts):
# the module loads OpenSSL's default provider and tolerates PQ-KAT
# mismatch; this tests PKCS#11 conformance, not FIPS validation.
# The token dir is fresh per cell.
PROVIDER_NAME=freehsm
PROVIDER_VERSION=main
PROVIDER_CANDIDATES='$TASK_DIR/freehsm/libfreehsm.so'
# FreeHSM rejects short SO PINs (CKR_PIN_INCORRECT on 4 chars); the cell
# PINs stay, only the SO PIN is overridden (throwaway, never echoed).
PROVIDER_SO_PIN=12345678
PROVIDER_SETUP=freehsm_setup
PROVIDER_ENV_VARS='FHSM_INTEGRITY_ALLOW_UNSIGNED=1 FHSM_KAT_ALLOW_FAIL=1 FHSM_TOKENS_DIR=$TASK_DIR/freehsm/tokens'
PROVIDER_TEARDOWN=
PROVIDER_SUITE=yes

freehsm_setup() {
  [ -f "$PKCS11_MODULE" ] || { echo "missing delivered libfreehsm.so: $PKCS11_MODULE" >&2; return 1; }
  dir=$1/freehsm
  mkdir -p "$dir/tokens" "$dir/audit"
  rm -f "$dir"/tokens/*
  "${PKCS11_TOOL:-pkcs11-tool}" --module "$PKCS11_MODULE" \
    --init-token --label "p11matrix" --so-pin "$P11TEST_SO_PIN"
  "${PKCS11_TOOL:-pkcs11-tool}" --module "$PKCS11_MODULE" \
    --init-pin --pin "$P11TEST_PIN" --so-pin "$P11TEST_SO_PIN"
}
