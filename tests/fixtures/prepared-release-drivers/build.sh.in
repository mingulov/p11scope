set -eu
ROOT=@ROOT@
P11SCOPE_PREPARED_STABLE_CARGO=@CARGO@
P11SCOPE_PREPARED_STABLE_RUSTC=@RUSTC@
P11SCOPE_PREPARED_BPF_CARGO=@BPF_CARGO@
P11SCOPE_PREPARED_BPF_RUSTC=@BPF_RUSTC@
case @OMIT@ in
    none) ;;
    *) unset "@OMIT@" ;;
esac
. @COMMAND@
