# shellcheck shell=bash disable=SC2034  # sourced interface: the cell reads these names
# SoftHSM2 2.7 system library — the known-good provider.
# Module candidates are probed in order (Debian/Fedora layouts); the token
# lives under $TASK_DIR/softhsm2-2.7/ and is fresh per cell.
PROVIDER_NAME=softhsm2-2.7
PROVIDER_VERSION=2.7
PROVIDER_CANDIDATES='/usr/lib64/pkcs11/libsofthsm2.so /usr/lib/x86_64-linux-gnu/softhsm/libsofthsm2.so /usr/lib/softhsm/libsofthsm2.so /usr/lib64/softhsm/libsofthsm2.so'
PROVIDER_SETUP=softhsm2_27_setup
PROVIDER_ENV_VARS='SOFTHSM2_CONF=$TASK_DIR/softhsm2-2.7/softhsm2.conf'
PROVIDER_TEARDOWN=
PROVIDER_SUITE=yes

# shellcheck disable=SC1090,SC1091  # shipped sibling, delivered with the env files
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_token_dir.sh"

softhsm2_27_setup() {
  dir=$1/softhsm2-2.7
  mkdir -p "$dir"
  printf 'directories.tokendir = %s\nobjectstore.backend = file\n' "$dir/tokens" >"$dir/softhsm2.conf"
  reset_task_token_dir "$dir/tokens" || return 1
  softhsm2-util --init-token --slot 0 --label "p11matrix" --pin "$P11TEST_PIN" --so-pin "$P11TEST_SO_PIN"
}
