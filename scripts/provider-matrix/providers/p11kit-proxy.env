# shellcheck shell=bash disable=SC2034  # sourced interface: the cell reads these names
# The p11-kit proxy: p11-kit-client.so forwards over a private socket to a
# p11-kit server started per cell, serving a task-folder SoftHSM token.
# The suite runs against the client module, so every call crosses the
# forwarding boundary. Server and client paths are probed, never assumed.
PROVIDER_NAME=p11kit-proxy
PROVIDER_VERSION=system
PROVIDER_CANDIDATES='/usr/lib64/pkcs11/p11-kit-client.so /usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so'
PROVIDER_SETUP=p11kit_proxy_setup
PROVIDER_ENV_VARS='P11_KIT_SERVER_ADDRESS=unix:path=$TASK_DIR/p11kit/server.sock SOFTHSM2_CONF=$TASK_DIR/p11kit/softhsm2.conf'
PROVIDER_TEARDOWN=p11kit_proxy_teardown
PROVIDER_SUITE=yes

p11kit_proxy_setup() {
  dir=$1/p11kit
  mkdir -p "$dir/tokens"
  command -v p11-kit >/dev/null 2>&1 || { echo "p11-kit server binary missing" >&2; return 1; }
  softhsm=
  for cand in /usr/lib64/pkcs11/libsofthsm2.so /usr/lib/x86_64-linux-gnu/softhsm/libsofthsm2.so; do
    if [ -f "$cand" ]; then softhsm=$cand; break; fi
  done
  [ -n "$softhsm" ] || { echo "no SoftHSM library to serve" >&2; return 1; }
  printf 'directories.tokendir = %s\nobjectstore.backend = file\n' "$dir/tokens" >"$dir/softhsm2.conf"
  rm -f "$dir"/tokens/*
  SOFTHSM2_CONF=$dir/softhsm2.conf softhsm2-util --init-token --slot 0 \
    --label "p11matrix" --pin "$P11TEST_PIN" --so-pin "$P11TEST_SO_PIN" || return 1
  # Stop a stale task-dir server first (pidfile, then task-scoped match).
  if [ -f "$dir/server.pid" ]; then
    kill "$(cat "$dir/server.pid")" 2>/dev/null || true
    rm -f "$dir/server.pid"
  fi
  rm -f "$dir/server.sock"
  SOFTHSM2_CONF=$dir/softhsm2.conf setsid -f p11-kit server \
    --provider "$softhsm" "unix:path=$dir/server.sock" \
    </dev/null >>"$dir/server.log" 2>&1 7>&- 8>&-
  for _ in $(seq 1 60); do
    [ -S "$dir/server.sock" ] && break
    sleep 1
  done
  [ -S "$dir/server.sock" ] || { echo "p11-kit server never bound $dir/server.sock; see $dir/server.log" >&2; return 1; }
  SRV=$(pgrep -f "unix:path=$dir/server.sock" | head -1)
  [ -n "$SRV" ] && echo "$SRV" >"$dir/server.pid"
  echo "p11-kit server up, serving $softhsm"
}

p11kit_proxy_teardown() {
  dir=$1/p11kit
  if [ -f "$dir/server.pid" ]; then
    kill "$(cat "$dir/server.pid")" 2>/dev/null || true
    rm -f "$dir/server.pid"
  fi
  pkill -f "p11-kit server --provider .*unix:path=$dir/server.sock" 2>/dev/null || true
  for _ in $(seq 1 30); do
    pgrep -f "unix:path=$dir/server.sock" >/dev/null 2>&1 || break
    sleep 1
  done
  pkill -9 -f "unix:path=$dir/server.sock" 2>/dev/null || true
  rm -f "$dir/server.sock"
}
