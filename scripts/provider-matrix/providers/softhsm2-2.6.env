# shellcheck shell=bash disable=SC2034  # sourced interface: the cell reads these names
# SoftHSM2 2.6.1 unpacked from the pinned Fedora rpm into the task folder
# (scripts/ci/fetch-provider.sh softhsm26). The token lives under
# $TASK_DIR/softhsm2-2.6/ and is fresh per cell.
PROVIDER_NAME=softhsm2-2.6
PROVIDER_VERSION=2.6.1
PROVIDER_CANDIDATES='$TASK_DIR/softhsm-2.6.1/root/usr/lib64/pkcs11/libsofthsm2.so'
PROVIDER_SETUP=softhsm2_26_setup
PROVIDER_ENV_VARS='SOFTHSM2_CONF=$TASK_DIR/softhsm2-2.6/softhsm2.conf'
PROVIDER_TEARDOWN=
PROVIDER_SUITE=yes

softhsm2_26_setup() {
  util=$1/softhsm-2.6.1/root/usr/bin/softhsm2-util
  [ -x "$util" ] || { echo "missing unpacked 2.6.1 rpm: $util" >&2; return 1; }
  dir=$1/softhsm2-2.6
  mkdir -p "$dir/tokens"
  printf 'directories.tokendir = %s\nobjectstore.backend = file\n' "$dir/tokens" >"$dir/softhsm2.conf"
  rm -f "$dir"/tokens/*
  "$util" --init-token --slot 0 --label "p11matrix" --pin "$P11TEST_PIN" --so-pin "$P11TEST_SO_PIN"
}
