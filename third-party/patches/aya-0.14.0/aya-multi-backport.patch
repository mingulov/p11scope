+            ProgramError::UProbeError(UProbeError::MultiLinkNotSupported)
+        } else {
+            ProgramError::SyscallError(SyscallError {
+                call: "bpf_link_create",
+                io_error,
+            })
+        }
+    })?;
+    Ok(PerfLinkInner::Fd(FdLink::new(link_fd)))
