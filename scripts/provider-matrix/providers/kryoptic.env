# shellcheck shell=bash disable=SC2034  # sourced interface: the cell reads these names
# Kryoptic 1.5.2 (multi-table: legacy 2.40 plus 3.2/3.0/2.40 interfaces).
# Module candidates are probed in order: the pinned rpm unpack
# (scripts/ci/fetch-provider.sh kryoptic) wins; a system kryoptic is the
# fallback. Token config + sqlite db live under $TASK_DIR/kryoptic/.
PROVIDER_NAME=kryoptic
PROVIDER_VERSION=1.5.2
PROVIDER_CANDIDATES='$TASK_DIR/kryoptic-rpm/usr/lib64/pkcs11/libkryoptic_pkcs11.so /usr/lib64/pkcs11/libkryoptic_pkcs11.so'
PROVIDER_SETUP=kryoptic_setup
PROVIDER_ENV_VARS='KRYOPTIC_CONF=$TASK_DIR/kryoptic/token.conf'
PROVIDER_TEARDOWN=
PROVIDER_SUITE=yes

kryoptic_setup() {
  [ -f "$PKCS11_MODULE" ] || { echo "missing kryoptic module: $PKCS11_MODULE" >&2; return 1; }
  dir=$1/kryoptic
  mkdir -p "$dir"
  printf '[[slots]]\nslot = 1\ndbtype = "sqlite"\ndbargs = "%s/token.sql"\n' "$dir" >"$dir/token.conf"
  rm -f "$dir/token.sql"
  "${PKCS11_TOOL:-pkcs11-tool}" --module "$PKCS11_MODULE" \
    --init-token --label "p11matrix" --so-pin "$P11TEST_SO_PIN"
  "${PKCS11_TOOL:-pkcs11-tool}" --module "$PKCS11_MODULE" \
    --init-pin --pin "$P11TEST_PIN" --so-pin "$P11TEST_SO_PIN"
}
