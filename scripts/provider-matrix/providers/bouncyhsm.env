# shellcheck shell=bash disable=SC2034  # sourced interface: the cell reads these names
# BouncyHsm v2.3.2 — thin client library forwarding over TCP to a .NET
# server. Calls are attributed to the client library the suite loaded;
# nothing claims to see inside the server process. Layout in the task
# folder (delivered before the cell):
#   $TASK_DIR/bouncyhsm/libbouncyhsm_pkcs11.so  client library
#   $TASK_DIR/bouncyhsm/server/                 published server (BouncyHsm.dll)
#   $TASK_DIR/bouncyhsm/dotnet/                 .NET runtime (DOTNET_ROOT)
# Server listens on 127.0.0.1:5000 with a fresh token DB per cell.
PROVIDER_NAME=bouncyhsm
PROVIDER_VERSION=2.3.2
PROVIDER_CANDIDATES='$TASK_DIR/bouncyhsm/libbouncyhsm_pkcs11.so'
PROVIDER_SETUP=bouncyhsm_setup
PROVIDER_ENV_VARS=
PROVIDER_TEARDOWN=bouncyhsm_teardown
PROVIDER_SUITE=yes

bouncyhsm_setup() {
  dir=$1/bouncyhsm
  [ -f "$dir/libbouncyhsm_pkcs11.so" ] || { echo "missing $dir/libbouncyhsm_pkcs11.so" >&2; return 1; }
  [ -f "$dir/server/BouncyHsm.dll" ] || { echo "missing $dir/server/BouncyHsm.dll" >&2; return 1; }
  export DOTNET_ROOT="$dir/dotnet" PATH="$dir/dotnet:$PATH"
  export DOTNET_TieredPGO="${DOTNET_TieredPGO:-0}"
  rm -f "$dir/server/appsettings.Production.json"
  # Fresh server + fresh token DB per cell: stop any stale task-dir server
  # first, by pidfile or by task-scoped argv match (never a bare
  # `dotnet BouncyHsm.dll` match: another lane may run its own copy).
  if [ -f "$dir/server.pid" ]; then
    kill "$(cat "$dir/server.pid")" 2>/dev/null || true
    rm -f "$dir/server.pid"
  fi
  pkill -f "$dir/dotnet/dotnet BouncyHsm.dll" 2>/dev/null || true
  for _ in $(seq 1 30); do
    pgrep -f "$dir/dotnet/dotnet BouncyHsm.dll" >/dev/null 2>&1 || break
    sleep 1
  done
  pkill -9 -f "$dir/dotnet/dotnet BouncyHsm.dll" 2>/dev/null || true
  rm -f "$dir"/server/data/BouncyHsm.db* "$dir"/server/data/BouncyHsm-log.db*
  # Fully detached start (own session, no lane fds, stdin closed): the
  # server must outlive the setup subshell, and must never inherit locks.
  cd "$dir/server" || return 1
  ASPNETCORE_ENVIRONMENT=Production ASPNETCORE_URLS=http://127.0.0.1:5000 \
    Logging__LogLevel__Default="${BHSM_LOG_LEVEL:-Warning}" \
    setsid -f "$DOTNET_ROOT/dotnet" BouncyHsm.dll \
    </dev/null >>"$dir/server.log" 2>&1 7>&- 8>&-
  cd - >/dev/null || return 1
  for _ in $(seq 1 20); do
    SRV=$(pgrep -f "$dir/dotnet/dotnet BouncyHsm.dll" | head -1)
    [ -n "$SRV" ] && { echo "$SRV" >"$dir/server.pid"; break; }
    sleep 1
  done
  for _ in $(seq 1 100); do
    curl -sf -o /dev/null http://127.0.0.1:5000/ 2>/dev/null && break
    sleep 1
  done
  curl -sf -o /dev/null http://127.0.0.1:5000/ || { echo "bouncyhsm server did not come up; see $dir/server.log" >&2; return 1; }
  # Slot PINs follow the cell's P11TEST_* PINs (never echoed; curl argv
  # only, like the --pin argv the token tools take elsewhere).
  curl -sf -X POST http://127.0.0.1:5000/Slot -H "Content-Type: application/json" \
    -d '{"IsHwDevice":false,"Description":"p11matrix","Token":{"Label":"p11matrix","SerialNumber":"0001","UserPin":"'"$P11TEST_PIN"'","SoPin":"'"$P11TEST_SO_PIN"'","SimulateHwRng":true,"SimulateHwMechanism":true,"SimulateProtectedAuthPath":false,"SimulateQualifiedArea":false,"SpeedMode":"WithoutRestriction"}}' \
    || { echo "slot creation failed" >&2; return 1; }
  echo "bouncyhsm server up, slot created"
}

bouncyhsm_teardown() {
  dir=$1/bouncyhsm
  if [ -f "$dir/server.pid" ]; then
    kill "$(cat "$dir/server.pid")" 2>/dev/null || true
    rm -f "$dir/server.pid"
  fi
  for _ in $(seq 1 30); do
    pgrep -f "$dir/dotnet/dotnet BouncyHsm.dll" >/dev/null 2>&1 || break
    sleep 1
  done
  pkill -9 -f "$dir/dotnet/dotnet BouncyHsm.dll" 2>/dev/null || true
}
