# shellcheck shell=bash disable=SC2034  # sourced interface: the cell reads these names
# The p11-kit proxy: p11-kit-client.so forwards over a private socket to a
# p11-kit server started per cell, serving a task-folder SoftHSM token.
# The suite runs against the client module, so every call crosses the
# forwarding boundary. Server and client paths are probed, never assumed.
PROVIDER_NAME=p11kit-proxy
PROVIDER_VERSION=system
PROVIDER_CANDIDATES='/usr/lib64/p11-kit-proxy.so /usr/lib64/pkcs11/p11-kit-client.so /usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so'
PROVIDER_SETUP=p11kit_proxy_setup
PROVIDER_ENV_VARS='SOFTHSM2_CONF=$TASK_DIR/p11kit/softhsm2.conf'
PROVIDER_TEARDOWN=p11kit_proxy_teardown
PROVIDER_SUITE=yes

p11kit_proxy_setup() {
  dir=$1/p11kit
  mkdir -p "$dir/tokens"
  command -v p11-kit >/dev/null 2>&1 || { echo "p11-kit server binary missing" >&2; return 1; }
  softhsm=
  for cand in /usr/lib64/pkcs11/libsofthsm2.so /usr/lib/x86_64-linux-gnu/softhsm/libsofthsm2.so; do
    if [ -f "$cand" ]; then softhsm=$cand; break; fi
  done
  [ -n "$softhsm" ] || { echo "no SoftHSM library to serve" >&2; return 1; }
  printf 'directories.tokendir = %s\nobjectstore.backend = file\n' "$dir/tokens" >"$dir/softhsm2.conf"
  rm -f "$dir"/tokens/*
  SOFTHSM2_CONF=$dir/softhsm2.conf softhsm2-util --init-token --slot 0 \
    --label "p11matrix" --pin "$P11TEST_PIN" --so-pin "$P11TEST_SO_PIN" || return 1
  # The server address is dynamic (a pid-keyed socket under the runtime
  # dir), so setup publishes it through the cell's extra-env hook.
  rm -f "$dir/server.sh"
  SOFTHSM2_CONF=$dir/softhsm2.conf p11-kit server --provider "$softhsm" \
    --sh "pkcs11:token=p11matrix" >"$dir/server.sh" 2>>"$dir/server.log" 7>&- 8>&- || {
    echo "p11-kit server failed to start; see $dir/server.log" >&2
    return 1
  }
  # shellcheck disable=SC1090
  . "$dir/server.sh"
  : "${P11_KIT_SERVER_ADDRESS:?server printed no address}"
  : "${P11_KIT_SERVER_PID:?server printed no pid}"
  echo "$P11_KIT_SERVER_PID" >"$dir/server.pid"
  printf 'P11_KIT_SERVER_ADDRESS=%s\n' "$P11_KIT_SERVER_ADDRESS" >"$1/.provider-extra-env"
  echo "p11-kit server up (pid $P11_KIT_SERVER_PID), serving $softhsm"
}

p11kit_server_pid_alive() {
  # True when $1 is still our server: guards the pidfile against pid reuse.
  [ -n "$1" ] && tr '\0' ' ' </proc/"$1"/cmdline 2>/dev/null | grep -q "p11-kit server"
}

p11kit_proxy_teardown() {
  dir=$1/p11kit
  [ -f "$dir/server.pid" ] || return 0
  srv=$(cat "$dir/server.pid")
  rm -f "$dir/server.pid"
  case $srv in ''|*[!0-9]*) return 0 ;; esac
  p11kit_server_pid_alive "$srv" || return 0
  kill "$srv" 2>/dev/null || return 0
  for _ in $(seq 1 30); do
    p11kit_server_pid_alive "$srv" || return 0
    sleep 1
  done
  p11kit_server_pid_alive "$srv" && kill -9 "$srv" 2>/dev/null
  return 0
}
