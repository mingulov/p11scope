# shellcheck shell=bash disable=SC2034  # sourced interface: the cell reads these names
# NSS softokn (libsoftokn3.so) as a plain provider: no token setup, so no
# suite legs (pkcs11-check needs slot 0 writable; softokn's slot 0 is the
# readonly internal services token). The cell proves C_Initialize works
# (workload-pace --iterations 0 as the preflight probe) and then observes
# the init + GetSlotList calls through the pkcs11-tool leg and the paced
# inventory workload. Module candidates are probed in order
# (Fedora/Debian layouts); the same env runs in CI (system libnss3) and
# on Fedora (nss-softokn), both pinned to one discover shape.
PROVIDER_NAME=nss-softokn
PROVIDER_VERSION=system
PROVIDER_CANDIDATES='/usr/lib64/libsoftokn3.so /usr/lib/x86_64-linux-gnu/libsoftokn3.so'
PROVIDER_SETUP=nss_softokn_setup
PROVIDER_ENV_VARS=
PROVIDER_TEARDOWN=
PROVIDER_SUITE=no
# Optional preflight: the cell runs it when setup fails and records the
# provider UNRUN (not failed) when the probe refuses.
PROVIDER_PREFLIGHT=nss_softokn_probe

nss_softokn_probe() {
  mkdir -p "$1/nss-softokn"
  # Init proof: initialise and finalise with no iterations. A nonzero
  # exit means no usable softokn here.
  python3 -I "$PROVIDER_MATRIX_DIR/workload-pace.py" --module "$PKCS11_MODULE" \
    --ready "$1/nss-softokn/probe.ready" --iterations 0
}

nss_softokn_setup() {
  [ -f "$PKCS11_MODULE" ] || { echo "missing softokn module: $PKCS11_MODULE" >&2; return 1; }
  nss_softokn_probe "$1"
}
