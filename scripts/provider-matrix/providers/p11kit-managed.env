# shellcheck shell=bash disable=SC2034  # sourced interface: the cell reads these names
# The real p11-kit aggregating proxy (/usr/lib64/p11-kit-proxy.so,
# Fedora-only: Debian ships no proxy aggregator) with a configured
# SoftHSM module under `managed: yes`. A private user config
# (XDG_CONFIG_HOME, user-config:only) isolates the proxy view to the one
# task-dir token; setup refuses unless the proxy serves exactly it. The
# suite runs against the proxy like any other provider, so run-observed
# and inventory-pid assert the calls are observed and attributed to the
# proxy module. Pairs with p11kit-unmanaged.env (`managed: no`).
PROVIDER_NAME=p11kit-managed
PROVIDER_VERSION=system
PROVIDER_CANDIDATES='/usr/lib64/p11-kit-proxy.so'
PROVIDER_SETUP=p11kit_managed_setup
PROVIDER_ENV_VARS='SOFTHSM2_CONF=$TASK_DIR/p11kit-managed/softhsm2.conf XDG_CONFIG_HOME=$TASK_DIR/p11kit-managed/xdg'
PROVIDER_TEARDOWN=
PROVIDER_SUITE=yes

# shellcheck disable=SC1090  # shipped sibling, delivered with the env files
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_p11kit_proxy_config.sh"

p11kit_managed_setup() {
  p11kit_proxy_config_setup "$1" yes p11kit-managed
}
