+    fn relocate_section_maps(
+        offsets: &[u32],
+        second_address: u64,
+    ) -> Result<Vec<bpf_insn>, RelocationError> {
+        let mut instructions = Vec::new();
+        let mut relocations = Vec::new();
+        for &offset in offsets {
+            relocations.push(Relocation {
+                offset: (instructions.len() * INS_SIZE) as u64,
+                symbol_index: 20,
+                size: 64,
+            });
+            let mut first = ins(&[0x18, 0x01, 0, 0, 0, 0, 0, 0]);
+            first.imm = offset as i32;
+            instructions.extend([first, ins(&[0; 8])]);
+        }
+        let mut fun = fake_func("section_maps", instructions);
+        let mut section = fake_sym(20, 0, 0, ".maps", 0);
+        section.kind = SymbolKind::Section;
+        let symbols = HashMap::from([
+            (1, fake_sym(1, 0, 0, "first", 40)),
+            (2, fake_sym(2, 0, second_address, "second", 32)),
+            (20, section),
+        ]);
+        let first = fake_btf_map(1);
+        let second = fake_btf_map(2);
+        let maps = HashMap::from([(1, ("first", 101, &first)), (2, ("second", 202, &second))]);
+        relocate_maps(
+            &mut fun,
+            relocations.iter(),
+            &HashMap::new(),
+            &maps,
+            &symbols,
+            &HashSet::new(),
+        )?;
+        Ok(fun.instructions)
+    }
+
+    #[test]
+    fn section_map_offsets_select_distinct_descriptors() {
+        let instructions = relocate_section_maps(&[40, 0, 40], 40).unwrap();
+        for (pair, expected) in instructions.chunks_exact(2).zip([202, 101, 202]) {
+            assert_eq!(pair[0].src_reg(), BPF_PSEUDO_MAP_FD as u8);
+            assert_eq!(pair[0].imm, expected);
+            assert_eq!(pair[1].imm, 0);
+        }
+    }
+
+    #[test]
+    fn section_map_offset_uses_unsigned_32_bit_addend() {
+        let instructions = relocate_section_maps(&[0x8000_0000], 0x8000_0000).unwrap();
+        assert_eq!(instructions[0].imm, 202);
+    }
+
+    #[test]
+    fn section_map_offsets_reject_interiors_and_missing_definitions() {
+        for offset in [1, 39, 41, 72, u32::MAX] {
+            assert!(relocate_section_maps(&[offset], 40).is_err(), "{offset}");
+        }
+    }
+
+    #[test]
