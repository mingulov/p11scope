+    let args = BpfLinkCreateArgs::UProbeMulti {
+        path,
+        offsets,
+        ref_ctr_offsets,
+        cookies,
+        pid,
+        flags: if retprobe {
+            BPF_F_UPROBE_MULTI_RETURN
+        } else {
+            0
+        },
+    };
+    bpf_link_create(
+        prog_fd,
+        LinkTarget::None,
+        bpf_attach_type::BPF_TRACE_UPROBE_MULTI,
+        0,
+        Some(args),
+    )
